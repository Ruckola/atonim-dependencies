{
  "id": "elevenlabs-tts",
  "name": "ElevenLabs TTS",
  "type": "tts_remote",
  "enabled": true,
  "connection": {"protocol": "https", "base_url_config_key": "elevenlabs_base_url", "default_base_url": "https://api.elevenlabs.io", "api_key": {"config_key": "elevenlabs_api_key", "env_var": "ELEVENLABS_API_KEY", "secret": true}},
  "server": {"managed": false, "start_supported": false, "stop_supported": false, "test_supported": true},
  "runtime": {"kind": "http_audio", "operation": "text_to_speech", "io": {"input_type": "text", "output_type": "audio"}, "method": "POST", "endpoint": "/v1/text-to-speech/{voice_id}", "timeout_seconds": 300, "auth": {"type": "api_key_header", "header": "xi-api-key", "config_key": "elevenlabs_api_key"}, "request": {"type": "json", "endpoint_mapping": {"voice_id": "parameters.voice"}, "parameter_mapping": {"text": "input.text", "model_id": "parameters.model", "voice_settings.stability": "parameters.stability", "voice_settings.similarity_boost": "parameters.similarity_boost", "voice_settings.style": "parameters.style", "voice_settings.use_speaker_boost": "parameters.speaker_boost", "voice_settings.speed": "parameters.speed"}, "input_limits": {"parameter_limits": [{"parameter": "model", "value": "eleven_v4", "max_characters": 10000}]}}, "response": {"type": "audio_bytes", "format": "mp3"}},
  "discovery": {"voices": {"type": "http_json", "method": "GET", "endpoint": "/v2/voices", "item_path": "voices", "label_key": "name", "value_key": "voice_id"}, "models": {"type": "http_json", "method": "GET", "endpoint": "/v1/models", "item_path": "models", "label_key": "name", "value_key": "model_id"}},
  "capabilities": {"text_to_speech": true, "voice_selection": true, "model_selection": true, "speed": true, "style": true, "stability": true, "similarity_boost": true, "speaker_boost": true},
  "parameters": {"voice": {"label": "Voice", "type": "select", "config_key": "elevenlabs_voice_id", "options": [], "ui": "combo", "ui_group": "basic"}, "model": {"label": "Model", "type": "select", "config_key": "elevenlabs_tts_model_id", "default": "eleven_multilingual_v2", "options": [], "ui": "combo", "ui_group": "basic"}, "stability": {"label": "Stability", "type": "number", "config_key": "elevenlabs_stability", "default": 0.5, "minimum": 0.0, "maximum": 1.0, "ui": "spin", "ui_group": "advanced", "advanced": true}, "similarity_boost": {"label": "Similarity", "type": "number", "config_key": "elevenlabs_similarity_boost", "default": 0.75, "minimum": 0.0, "maximum": 1.0, "ui": "spin", "ui_group": "advanced", "advanced": true}, "style": {"label": "Style", "type": "number", "config_key": "elevenlabs_style", "default": 0.0, "minimum": 0.0, "maximum": 1.0, "ui": "spin", "ui_group": "advanced", "advanced": true}, "speed": {"label": "Speed", "type": "number", "config_key": "elevenlabs_speed", "default": 1.0, "minimum": 0.7, "maximum": 1.2, "ui": "spin", "ui_group": "basic"}, "speaker_boost": {"label": "Speaker boost", "type": "boolean", "config_key": "elevenlabs_use_speaker_boost", "default": true, "ui": "checkbox", "ui_group": "advanced", "advanced": true}}
}
