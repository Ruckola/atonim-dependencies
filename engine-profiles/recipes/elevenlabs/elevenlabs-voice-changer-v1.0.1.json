{
  "id": "elevenlabs-voice-changer",
  "name": "ElevenLabs Voice Changer",
  "type": "sts_remote",
  "enabled": true,
  "connection": {"protocol": "https", "base_url_config_key": "elevenlabs_base_url", "default_base_url": "https://api.elevenlabs.io", "api_key": {"config_key": "elevenlabs_api_key", "env_var": "ELEVENLABS_API_KEY", "secret": true}},
  "server": {"managed": false, "start_supported": false, "stop_supported": false, "test_supported": true},
  "runtime": {"kind": "http_audio", "operation": "voice_conversion", "io": {"input_type": "audio", "output_type": "audio"}, "method": "POST", "endpoint": "/v1/voice-changer/{voice_id}", "timeout_seconds": 300, "auth": {"type": "api_key_header", "header": "xi-api-key", "config_key": "elevenlabs_api_key"}, "request": {"type": "multipart", "endpoint_mapping": {"voice_id": "parameters.voice"}, "parameter_mapping": {"audio": "input.source_audio", "model_id": "parameters.model", "voice_settings.stability": "parameters.stability", "voice_settings.similarity_boost": "parameters.similarity_boost", "voice_settings.use_speaker_boost": "parameters.speaker_boost"}}, "response": {"type": "audio_bytes", "format": "mp3"}},
  "discovery": {"voices": {"type": "http_json", "method": "GET", "endpoint": "/v2/voices", "item_path": "voices", "label_key": "name", "value_key": "voice_id", "pagination": {"type": "cursor", "cursor_response_key": "next_page_token", "cursor_request_param": "page_token", "has_more_key": "has_more", "limit_param": "page_size", "limit": 100, "max_pages": 10}}, "models": {"type": "http_json", "method": "GET", "endpoint": "/v1/models", "item_path": "models", "label_key": "name", "value_key": "model_id", "item_filter": {"can_do_voice_conversion": true}}},
  "capabilities": {"voice_conversion": true, "voice_selection": true, "model_selection": true, "stability": true, "similarity_boost": true, "speaker_boost": true},
  "parameters": {"voice": {"label": "Voice", "type": "select", "config_key": "elevenlabs_voice_id", "display_config_key": "elevenlabs_voice_name", "options": [], "ui": "combo", "ui_group": "basic"}, "model": {"label": "Model", "type": "select", "config_key": "elevenlabs_voice_changer_model_id", "display_config_key": "elevenlabs_voice_changer_model_name", "options": [], "ui": "combo", "ui_group": "basic"}, "stability": {"label": "Stability", "type": "number", "config_key": "elevenlabs_stability", "default": 0.5, "minimum": 0.0, "maximum": 1.0, "ui": "spin", "ui_group": "advanced", "advanced": true}, "similarity_boost": {"label": "Similarity", "type": "number", "config_key": "elevenlabs_similarity_boost", "default": 0.75, "minimum": 0.0, "maximum": 1.0, "ui": "spin", "ui_group": "advanced", "advanced": true}, "speaker_boost": {"label": "Speaker boost", "type": "boolean", "config_key": "elevenlabs_use_speaker_boost", "default": true, "ui": "checkbox", "ui_group": "advanced", "advanced": true}}
}
