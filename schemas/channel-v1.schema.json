{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atonim dependency channel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "manifest"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "manifest": {
            "type": "string",
            "pattern": "^components/.+/versions/[0-9]+\\.[0-9]+\\.[0-9]+\\.json$"
          }
        }
      }
    }
  }
}
