{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atonim authenticated channel v2: producer contract",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "channel", "components"],
  "properties": {
    "schema_version": {"const": 2},
    "channel": {"enum": ["stable", "beta"]},
    "components": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "manifest_url"],
        "properties": {
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "manifest_url": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))https://raw\\.githubusercontent\\.com/Ruckola/atonim-dependencies/[^/?#]+/(channels|components)/[^?#]+\\.json$"}
        }
      }
    }
  }
}
