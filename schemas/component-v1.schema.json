{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atonim dependency component manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "upstream",
    "artifacts",
    "redistribution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "upstream": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atonim_min": {
          "type": "string"
        },
        "atonim_max_exclusive": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleared",
        "notices_path"
      ],
      "properties": {
        "cleared": {
          "const": true
        },
        "notices_path": {
          "type": "string",
          "minLength": 1
        },
        "sbom_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "architecture",
          "url",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "platform": {
            "enum": [
              "macos",
              "windows",
              "linux",
              "any"
            ]
          },
          "architecture": {
            "enum": [
              "arm64",
              "x86_64",
              "any"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/Ruckola/atonim-dependencies/releases/download/[^/]+/[^/]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "enum": [
              "tar.gz",
              "zip",
              "tar.zst"
            ]
          }
        }
      }
    }
  }
}
