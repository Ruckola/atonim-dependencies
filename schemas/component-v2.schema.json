{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atonim component manifest v2: producer contract",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "description", "languages", "requires", "compatibility", "artifact", "exports", "health", "redistribution"],
  "$defs": {
    "componentId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "codes": {"type": "array", "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
  },
  "properties": {
    "schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/componentId"}, "version": {"$ref": "#/$defs/version"},
    "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "items": {"type": "string"}},
    "requires": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/componentId"}, "version": {"$ref": "#/$defs/version"}}}},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "min_app_version", "max_app_version"],
      "properties": {"platform": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "min_app_version": {"$ref": "#/$defs/version"}, "max_app_version": {"$ref": "#/$defs/version"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "url", "sha256", "size_bytes", "extracted_size_bytes"],
      "properties": {
        "format": {"const": "tar.gz"},
        "url": {"type": "string", "pattern": "^https://github\\.com/Ruckola/atonim-dependencies/releases/download/[^/?#]+/[^/?#]+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1}, "extracted_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "exports": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["path", "type"],
        "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "type": {"enum": ["file", "directory", "executable"]}, "sha256": {"$ref": "#/$defs/digest"}},
        "allOf": [{"if": {"properties": {"type": {"enum": ["file", "executable"]}}, "required": ["type"]}, "then": {"required": ["sha256"]}}]
      }
    },
    "health": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["export", "argv"],
        "properties": {"export": {"type": "string"}, "argv": {"enum": [["--help"], ["--version"]]}, "success_exit_codes": {"$ref": "#/$defs/codes"}, "empty_stderr_exit_codes": {"$ref": "#/$defs/codes"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 90}}
      }
    },
    "redistribution": {"type": "object", "required": ["cleared"], "properties": {"cleared": {"const": true}}}
  }
}
